# Copy to a private shell config or to .env.cryosparc; do not commit secrets.

# CryoSPARC instance. Use the master hostname reachable from this machine.
export CRYOSPARC_HOST=localhost
export CRYOSPARC_BASE_PORT=40000

# CryoSPARC user credentials for cryosparc-tools.
export CRYOSPARC_EMAIL=you@example.edu
export CRYOSPARC_PASSWORD='replace-me'

# Project defaults for this repository.
export CRYOSPARC_PROJECT_UID=CS-prestin
export CRYOSPARC_WORKSPACE_UID=W1
export CRYOSPARC_PROJECT_DIR=/nfs/bartesaghilab2/zy223/cryosparc/Prestin/CS-prestin

# Optional: set this when running on the CryoSPARC master host.
export CRYOSPARC_MASTER_DIR=/path/to/cryosparc_master
