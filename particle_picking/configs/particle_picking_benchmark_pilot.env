# Pilot configuration for denoising-assisted Prestin particle-picking benchmark.
# Source via: scripts/run_particle_picking_benchmark.sh configs/particle_picking_benchmark_pilot.env

# Small local subset for first particle-picking benchmark pilot.
RAW_DIR=/nfs/bartesaghilab2/zy223/denoising/data/subset
MRC_GLOB=*.mrc
LIMIT=5

# Pretrained denoised outputs corresponding to the local subset.
TOPAZ_DIR=/nfs/bartesaghilab2/zy223/denoising/results/topaz_pretrained
DRACO_DIR=/nfs/bartesaghilab2/zy223/denoising/results/draco_pretrained
TOPAZ_SUFFIX=
DRACO_SUFFIX=_draco_denoised

# Output location. RUN_ID defaults to a timestamp if left blank.
OUTPUT_ROOT=/nfs/bartesaghilab2/zy223/particle_picking/results/particle_picking_benchmark
RUN_ID=

# DoG/NMS detector parameters. Keep identical across raw/topaz/draco.
DOG_SIGMA_SMALL=3.0
DOG_SIGMA_LARGE=9.0
DOG_POLARITY=absolute
DOG_THRESHOLD_SIGMA=4.0
DOG_MIN_DISTANCE=90
DOG_MAX_PICKS=1000
DOG_MATCH_RADIUS=48
DOG_BOX_SIZE=256
DOG_OVERLAY_MAX_PICKS=300
DOG_OVERLAY_DOWNSAMPLE=4
DOG_OVERLAY_CONTRAST_PERCENTILES=1,99

# Command-line nextPYP/PYP container.
PYP_SIF=/nfs/bartesaghilab/www/files/pyp/0.7.3/pyp.sif
CONTAINER_RUNTIME=apptainer
PYP_BINDS="--bind /nfs/bartesaghilab2:/nfs/bartesaghilab2 --bind /nfs/bartesaghilab:/nfs/bartesaghilab --bind /nfs/bartesaghilab/www:/nfs/bartesaghilab/www"

# nextPYP pilot defaults. RUN_NEXTPYP=0 writes runnable command files only.
RUN_NEXTPYP=0
SCOPE_VOLTAGE=300
SCOPE_PIXEL=1.07
SCOPE_CS=2.7
SCOPE_WGH=0.07
CTF_MIN_RES=50
CTF_MAX_RES=3.5
CTF_MIN_DEF=3500
CTF_MAX_DEF=50000
CTF_TILE=512
CTF_FSTEP=250
CTF_USE_AST=true
DETECT_METHOD=auto
DETECT_RAD=55
DETECT_DIST=90
DETECT_THRE=0.25
SLURM_TASKS=1
SLURM_MEMORY=32
